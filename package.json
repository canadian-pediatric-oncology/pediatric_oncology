{
  "name": "canadian-pediatric-oncology-resource",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-path dist/pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa": "npm run check && npm run format:check && npm run test:unit && node scripts/check-medical-expiry.cjs && node scripts/check-charity-expiry.cjs",
    "test": "npm run qa",
    "test:unit": "node --experimental-strip-types --test tests/unit/",
    "test:a11y": "node scripts/audit-a11y.cjs",
    "test:e2e": "playwright test",
    "content-status": "node scripts/generate-content-status.cjs",
    "ci": "npm run qa && npm run build",
    "check-charity-expiry": "node scripts/check-charity-expiry.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@playwright/test": "^1.62.1",
    "pa11y": "^9.1.1",
    "pa11y-ci": "^4.0.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "serve": "^14.2.4",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.4"
  }
}
