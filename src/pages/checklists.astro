---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const targetPath = `${basePath}/en/checklists`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <link rel="canonical" href={targetPath} />
    <title>Redirecting...</title>
    <script is:inline define:vars={{ basePath }}>
      const lang = navigator.language.split("-")[0];
      const targetLang = ["en", "fr", "zh"].includes(lang) ? lang : "en";
      window.location.replace(`${basePath}/${targetLang}/checklists`);
    </script>
  </head>
  <body
    class="flex items-center justify-center min-h-screen bg-gray-50 text-center font-sans p-4"
  >
    <div>
      <p class="text-gray-600 mb-4">
        Redirecting you to the Checklists page...
      </p>
      <a href={targetPath} class="text-primary hover:underline">
        Click here if you are not redirected automatically.
      </a>
    </div>
  </body>
</html>
