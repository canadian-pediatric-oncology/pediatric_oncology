---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import GovernmentBenefits from "../../components/support/GovernmentBenefits.astro";
import InternationalHospitalGrid from "../../components/support/InternationalHospitalGrid.astro";
import ProvincialSection from "../../components/support/ProvincialSection.astro";
import { translations, type Locale } from "../../i18n/translations";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "fr" } },
    { params: { lang: "zh" } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang as Locale) || "en";
const t = translations[currentLang] || translations.en;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl =
  currentLang === "en" ? `${basePath}/` : `${basePath}/${currentLang}`;

const breadcrumbs = [
  { label: t.nav.home, href: homeUrl },
  { label: t.nav.support },
];

const provinces = await getCollection(
  "provinces",
  ({ data }) => data.lang === currentLang,
);
provinces.sort((a, b) => a.data.title.localeCompare(b.data.title));

const allCharities = await getCollection(
  "charities",
  ({ data }) => data.lang === currentLang,
);

const nationalCharities = allCharities
  .filter((c) => c.data.scope !== "provincial")
  .sort((a, b) => {
    const scopeOrder: Record<string, number> = {
      national: 1,
      indigenous: 2,
      international: 3,
    };
    return (scopeOrder[a.data.scope] || 9) - (scopeOrder[b.data.scope] || 9);
  });

function getScopeTag(scope: string, l: string) {
  if (scope === "national")
    return "🇨🇦 " + (l === "fr" ? "National" : l === "zh" ? "全国" : "National");
  if (scope === "provincial")
    return (
      "📍 " +
      (l === "fr" ? "Provincial" : l === "zh" ? "省/地区" : "Provincial")
    );
  if (scope === "indigenous")
    return (
      "🪶 " + (l === "fr" ? "Autochtone" : l === "zh" ? "原住民" : "Indigenous")
    );
  if (scope === "international")
    return (
      "🌎 " +
      (l === "fr" ? "International" : l === "zh" ? "国际" : "International")
    );
  return "";
}

const labels = {
  selectedResources: t.filter.selectedResources,
  hospitalsHeading: t.filter.hospitalsHeading,
  financialHeading: t.filter.financialHeading,
  provincialCharitiesHeading:
    currentLang === "fr"
      ? "Organismes de bienfaisance provinciaux"
      : currentLang === "zh"
        ? "省级慈善机构"
        : "Provincial Charities & Support",
};

const fallbackHeading =
  currentLang === "fr"
    ? "Ressources internationales et de dernier recours"
    : currentLang === "zh"
      ? "国际与备用资源"
      : "International & Fallback Resources";
---

<Layout
  title={t.support.title}
  lang={currentLang}
  description={t.support.subtitle}
>
  <Breadcrumbs crumbs={breadcrumbs} lang={currentLang} />

  <div class="mb-8 border-b pb-6">
    <div class="flex items-center gap-3">
      <div class="p-2 bg-accent-light rounded-lg">
        <svg
          class="w-8 h-8 text-accent shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          ></path>
        </svg>
      </div>
      <h1
        class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl text-balance"
      >
        {t.support.title}
      </h1>
    </div>
    <p class="mt-4 text-lg text-gray-600 text-balance">{t.support.subtitle}</p>
  </div>

  <provincial-support-manager class="block">
    <!-- Unified Filter -->
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 my-8">
      <label
        for="province-select"
        class="block text-lg font-bold text-gray-900 mb-4"
      >
        {t.filter.label}
      </label>
      <select
        id="province-select"
        class="block w-full max-w-sm pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary focus:border-primary sm:text-sm rounded-md bg-gray-50 border"
      >
        <option value="" selected>{t.filter.placeholder}</option>
        {
          provinces.map((p) => (
            <option value={p.data.province_key}>{p.data.title}</option>
          ))
        }
      </select>
    </div>

    <!-- PROVINCIAL RESOURCES (Hidden by default) -->
    <div id="provincial-resources-container">
      {
        provinces.map((prov) => {
          const provCharities = allCharities.filter(
            (c) =>
              c.data.scope === "provincial" &&
              c.data.province === prov.data.title,
          );
          return (
            <ProvincialSection
              province={prov}
              provCharities={provCharities}
              lang={currentLang}
              labels={labels}
            />
          );
        })
      }
    </div>

    <!-- NATIONAL / DEFAULT RESOURCES -->
    <div id="national-view" class="mt-12">
      <section class="pt-8 border-t border-gray-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
          {t.support.nationalTitle}
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-10">
          {
            nationalCharities.map((c) => (
              <ResourceCard
                title={c.data.name}
                desc={c.body || ""}
                link={c.data.url}
                services={c.data.services}
                tags={[getScopeTag(c.data.scope, currentLang)]}
                lang={currentLang}
              />
            ))
          }
        </div>
      </section>

      <!-- EI Fallback Section -->
      <section
        id="national-fallback-section"
        class="pt-8 border-t border-gray-200"
      >
        <h2 class="text-2xl font-bold text-gray-900 mb-2">
          {fallbackHeading}
        </h2>
        <p class="text-gray-600 mb-6 text-sm sm:text-base">
          {t.support.nationalSubtitle}
        </p>

        <GovernmentBenefits lang={currentLang} />

        <InternationalHospitalGrid lang={currentLang} />
      </section>
    </div>
  </provincial-support-manager>
</Layout>

<script>
  class ProvincialSupportManager extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector<HTMLSelectElement>("#province-select");
      const nationalFallbackSection = this.querySelector(
        "#national-fallback-section",
      );
      const provinceViews = this.querySelectorAll(".province-view");

      if (select) {
        select.addEventListener("change", (e) => {
          const selectedProv = (e.target as HTMLSelectElement).value;

          if (selectedProv) {
            if (nationalFallbackSection)
              nationalFallbackSection.classList.add("hidden");

            provinceViews.forEach((view) => {
              if (view.getAttribute("data-province-id") === selectedProv) {
                view.classList.remove("hidden");
                view.classList.add("animate-fade-in");
              } else {
                view.classList.add("hidden");
                view.classList.remove("animate-fade-in");
              }
            });
          } else {
            if (nationalFallbackSection)
              nationalFallbackSection.classList.remove("hidden");
            provinceViews.forEach((view) => view.classList.add("hidden"));
          }
        });
      }
    }
  }

  if (!customElements.get("provincial-support-manager")) {
    customElements.define(
      "provincial-support-manager",
      ProvincialSupportManager,
    );
  }
</script>
